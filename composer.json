{
  "name": "fullworks/broadcaster-auto-responder-for-gravity-forms-project",
  "description": "Development project for the Broadcaster Auto Responder for Gravity Forms WordPress plugin",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "alan",
      "email": "alan@fullworksplugins.com"
    }
  ],
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "3.*",
    "wp-coding-standards/wpcs": ">=2.3.0",
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpunit/phpunit": "^9.5",
    "yoast/phpunit-polyfills": "^1.1"
  },
  "scripts": {
    "post-update-cmd": [
      "@plugin-update",
      "@make-pot"
    ],
    "plugin-update": "if [ -f broadcaster-auto-responder-for-gravity-forms/composer.json ]; then composer update -d broadcaster-auto-responder-for-gravity-forms; fi",
    "make-pot": "mkdir -p broadcaster-auto-responder-for-gravity-forms/languages && wp i18n make-pot ./broadcaster-auto-responder-for-gravity-forms ./broadcaster-auto-responder-for-gravity-forms/languages/broadcaster-auto-responder-for-gravity-forms.pot --skip-audit --exclude='vendor,includes/vendor,node_modules'",
    "build": [
      "if [ -f broadcaster-auto-responder-for-gravity-forms/composer.json ]; then composer install -d broadcaster-auto-responder-for-gravity-forms --no-dev; fi",
      "mkdir -p zipped",
      "wp dist-archive broadcaster-auto-responder-for-gravity-forms zipped/broadcaster-auto-responder-for-gravity-forms-free.zip --force"
    ],
    "phpcs": "phpcs broadcaster-auto-responder-for-gravity-forms -s --standard=phpcs_sec.xml --ignore=*/vendor/* --extensions=php",
    "compat:8.4": "phpcs broadcaster-auto-responder-for-gravity-forms -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.4",
    "compat:8.3": "phpcs broadcaster-auto-responder-for-gravity-forms -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.3",
    "compat:8.2": "phpcs broadcaster-auto-responder-for-gravity-forms -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.2",
    "compat:8.1": "phpcs broadcaster-auto-responder-for-gravity-forms -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.1",
    "compat:8.0": "phpcs broadcaster-auto-responder-for-gravity-forms -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.0",
    "compat:7.4": "phpcs broadcaster-auto-responder-for-gravity-forms -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 7.4",
    "check": [
      "@compat:8.4",
      "@compat:8.3",
      "@compat:8.2",
      "@compat:8.1",
      "@compat:8.0",
      "@compat:7.4",
      "@phpcs"
    ],
    "test": "npm test"
  }
}
