{
    "name": "fullworks/broadcaster-auto-responder-for-gravity-forms-dev",
    "description": "Build/dev tooling for the Broadcaster Auto Responder for Gravity Forms WordPress plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Alan Fuller",
            "email": "alan@fullworks.net",
            "homepage": "https://fullworks.net"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpunit/phpunit": "^9.5",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "scripts": {
        "lint": "./vendor/bin/phpcs",
        "lint:fix": "./vendor/bin/phpcbf",
        "phpcs-security": "./vendor/bin/phpcs -p --standard=phpcs_sec.xml",
        "phpcompat": "./vendor/bin/phpcs -p --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 7.4- broadcaster-auto-responder-for-gravity-forms",
        "test": "./vendor/bin/phpunit -c tests/phpunit.xml.dist",
        "test:unit": "./vendor/bin/phpunit -c tests/phpunit-unit.xml.dist",
        "test:integration": "./vendor/bin/phpunit -c tests/phpunit.xml.dist --testsuite integration",
        "make-pot": "mkdir -p broadcaster-auto-responder-for-gravity-forms/languages && wp i18n make-pot ./broadcaster-auto-responder-for-gravity-forms ./broadcaster-auto-responder-for-gravity-forms/languages/broadcaster-auto-responder-for-gravity-forms.pot --skip-audit --exclude='vendor,node_modules,tests,bin'",
        "plugin:install": "cd broadcaster-auto-responder-for-gravity-forms && composer install --no-dev --optimize-autoloader",
        "plugin:update": "cd broadcaster-auto-responder-for-gravity-forms && composer update --no-dev --optimize-autoloader",
        "plugin:dump": "cd broadcaster-auto-responder-for-gravity-forms && composer dump-autoload --optimize",
        "build": "composer run-script plugin:install && composer run-script make-pot && rm -rf dist && mkdir -p dist && wp dist-archive ./broadcaster-auto-responder-for-gravity-forms ./dist/broadcaster-auto-responder-for-gravity-forms.zip --plugin-dirname=broadcaster-auto-responder-for-gravity-forms"
    },
    "scripts-descriptions": {
        "lint": "Run PHP_CodeSniffer to detect coding standard violations",
        "lint:fix": "Run PHP Code Beautifier to fix coding standard violations",
        "test": "Run all PHPUnit tests",
        "test:unit": "Run PHPUnit unit tests only",
        "test:integration": "Run PHPUnit integration tests only",
        "make-pot": "Generate POT file for translations",
        "plugin:install": "Install plugin dependencies and generate autoloader",
        "plugin:update": "Update plugin dependencies and regenerate autoloader",
        "plugin:dump": "Regenerate plugin autoloader without installing",
        "build": "Build the plugin with dependencies, language files and create distribution archive"
    }
}