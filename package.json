{
    "name": "broadcaster-auto-responder-for-gravity-forms",
    "version": "1.0.2",
    "description": "Sends Gravity Forms submissions to Broadcaster as incoming WhatsApp contact messages.",
    "author": "Fullworks",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "gravity-forms",
        "broadcaster",
        "whatsapp"
    ],
    "homepage": "https://github.com/alanef/plugin-broadcaster-auto-responder-for-gravity-forms-project",
    "repository": {
        "type": "git",
        "url": "https://github.com/alanef/plugin-broadcaster-auto-responder-for-gravity-forms-project.git"
    },
    "bugs": {
        "url": "https://github.com/alanef/plugin-broadcaster-auto-responder-for-gravity-forms-project/issues"
    },
    "scripts": {
        "env:start": "wp-env start --xdebug",
        "env:stop": "wp-env stop",
        "env:restart": "wp-env stop && wp-env start",
        "env:reset": "wp-env destroy && wp-env start",
        "env:cli": "wp-env run cli",
        "env:logs": "wp-env logs",
        "lint:php": "composer run-script lint",
        "lint:php:fix": "composer run-script lint:fix",
        "test": "wp-env run tests-cli 'cd /var/www/html/wp-content/plugins/broadcaster-auto-responder-for-gravity-forms && ./vendor/bin/phpunit'",
        "test:unit": "wp-env run tests-cli 'cd /var/www/html/wp-content/plugins/broadcaster-auto-responder-for-gravity-forms && ./vendor/bin/phpunit --testsuite unit'",
        "test:integration": "wp-env run tests-cli 'cd /var/www/html/wp-content/plugins/broadcaster-auto-responder-for-gravity-forms && ./vendor/bin/phpunit --testsuite integration'",
        "build": "composer run-script build",
        "setup": "./bin/setup-plugin.sh",
        "composer:install": "composer install",
        "composer:update": "composer update",
        "plugin:install": "composer run-script plugin:install",
        "plugin:update": "composer run-script plugin:update",
        "plugin:dump": "composer run-script plugin:dump"
    },
    "devDependencies": {
        "@wordpress/env": "^9.0.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=8.0.0"
    }
}
