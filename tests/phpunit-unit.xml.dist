<?xml version="1.0"?>
<phpunit
    bootstrap="bootstrap-unit.php"
    backupGlobals="false"
    colors="true"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true"
    verbose="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">./unit</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">../broadcaster-auto-responder-for-gravity-forms/includes</directory>
        </include>
        <exclude>
            <directory>../broadcaster-auto-responder-for-gravity-forms/vendor</directory>
        </exclude>
    </coverage>
</phpunit>
